# Copy this file to .env and fill in real values.
# Never commit .env (it is gitignored).

# Django
SECRET_KEY=
# Local development (recommended):
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=

# Production example:
DEBUG=False
ALLOWED_HOSTS=roshe.devtownhosting.com
CSRF_TRUSTED_ORIGINS=https://roshe.devtownhosting.com

# Safety switches
# Disable dev-only reset/seed features in production.
ENABLE_SEED_TOOLS=False

# Do NOT allow silently falling back to SQLite in production.
POSTGRES_FALLBACK_TO_SQLITE=False

# Database
# Use Postgres in production
DB_ENGINE=postgresql
DB_HOST=
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Email (SMTP) - cPanel mail example
# For business@roshegroup.com:
EMAIL_HOST=mail.roshegroup.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=business@roshegroup.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=business@roshegroup.com

# Optional: if behind nginx / reverse proxy terminating TLS
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
